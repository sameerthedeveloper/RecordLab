# Firebase project config (Project settings → General → Your apps → SDK setup).
# Copy this file to .env.local and fill in your project's values.
# These are public client identifiers, not secrets — access control lives in
# firestore.rules, not in hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google AdSense (optional). With these unset, ad spots show a labelled placeholder.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-8456716793700424
NEXT_PUBLIC_ADSENSE_SLOT_LANDING_1=
NEXT_PUBLIC_ADSENSE_SLOT_LANDING_2=
NEXT_PUBLIC_ADSENSE_SLOT_RECORDS=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_EDITOR=
NEXT_PUBLIC_ADSENSE_SLOT_PREVIEW=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER_LEFT=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER_RIGHT=

# Google OAuth client (Drive link)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
